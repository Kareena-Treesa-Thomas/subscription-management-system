# Postgres (docker compose up -d)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brightloop?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/brightloop?schema=public"

# Auth.js  (generate with: npx auth secret   or   openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_TRUST_HOST=true
APP_URL="http://localhost:3000"

# Optional SMTP. If SMTP_HOST is empty, the reset link prints in the server console
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Brightloop <no-reply@brightloop.test>"

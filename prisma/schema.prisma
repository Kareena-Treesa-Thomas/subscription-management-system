// SHARED SCHEMA. Change via PR/discussion; every member builds on this.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum DiscountScope {
  PRODUCT
  SUBSCRIPTION
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  passwordHash  String
  role          Role           @default(CUSTOMER)
  address       String?
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]
  invoices      Invoice[]
  passwordResetTokens PasswordResetToken[]
}

model Product {
  id         String           @id @default(cuid())
  name       String
  type       String
  salesPrice Decimal          @db.Decimal(12, 2)
  costPrice  Decimal          @db.Decimal(12, 2)
  notes      String?
  taxId      String?
  tax        Tax?             @relation(fields: [taxId], references: [id])
  variants   ProductVariant[]
  createdAt  DateTime         @default(now())
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute  String // e.g. "brand"
  value      String // e.g. "Odoo"
  extraPrice Decimal @default(0) @db.Decimal(12, 2) // Odoo adds 560

  @@index([productId])
}

model Tax {
  id       String             @id @default(cuid())
  name     String
  ratePct  Decimal            @db.Decimal(5, 2)
  active   Boolean            @default(true)
  products Product[]
  lines    SubscriptionLine[]
}

model Plan {
  id            String              @id @default(cuid())
  name          String
  price         Decimal             @db.Decimal(12, 2)
  billingPeriod BillingPeriod
  minQuantity   Int                 @default(1)
  availableFrom DateTime?
  availableTo   DateTime?
  autoClose     Boolean             @default(false)
  closableEarly Boolean             @default(true)
  pausable      Boolean             @default(false)
  renewable     Boolean             @default(true)
  subscriptions Subscription[]
  templates     QuotationTemplate[]
}

model Discount {
  id          String               @id @default(cuid())
  name        String
  type        DiscountType
  value       Decimal              @db.Decimal(12, 2)
  minPurchase Decimal?             @db.Decimal(12, 2)
  minQuantity Int?
  startDate   DateTime
  endDate     DateTime
  usageLimit  Int?
  usedCount   Int                  @default(0)
  scope       DiscountScope
  productId   String? // when scope = PRODUCT
  active      Boolean              @default(true)
  redemptions DiscountRedemption[]

  @@index([active, startDate, endDate])
}

model DiscountRedemption {
  id         String   @id @default(cuid())
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id])
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([discountId, invoiceId])
}

model QuotationTemplate {
  id           String                  @id @default(cuid())
  name         String
  planId       String
  plan         Plan                    @relation(fields: [planId], references: [id])
  validityDays Int                     @default(30)
  lines        QuotationTemplateLine[]
}

model QuotationTemplateLine {
  id         String            @id @default(cuid())
  templateId String
  template   QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  productId  String
  variantId  String?
  quantity   Int               @default(1)
}

model Subscription {
  id                  String             @id @default(cuid())
  number              String             @unique // SUB-00001
  customerId          String
  customer            User               @relation(fields: [customerId], references: [id])
  planId              String
  plan                Plan               @relation(fields: [planId], references: [id])
  status              SubscriptionStatus @default(DRAFT)
  startDate           DateTime
  expiryDate          DateTime?
  paymentTerms        String             @default("Net 15")
  paymentTermsDays    Int                @default(15)
  nextInvoiceDate     DateTime? // set when ACTIVE; billing picks rows <= today
  quotationValidUntil DateTime?
  paused              Boolean            @default(false)
  createdAt           DateTime           @default(now())
  lines               SubscriptionLine[]
  invoices            Invoice[]

  @@index([status])
  @@index([status, nextInvoiceDate])
  @@index([customerId])
}

model SubscriptionLine {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      String
  variantId      String?
  description    String
  quantity       Int
  unitPrice      Decimal      @db.Decimal(12, 2)
  taxId          String?
  tax            Tax?         @relation(fields: [taxId], references: [id])
  amount         Decimal      @db.Decimal(12, 2) // quantity * unitPrice (pre-tax)
}

model Invoice {
  id             String               @id @default(cuid())
  number         String               @unique // INV-00001
  subscriptionId String
  subscription   Subscription         @relation(fields: [subscriptionId], references: [id])
  customerId     String
  customer       User                 @relation(fields: [customerId], references: [id])
  status         InvoiceStatus        @default(DRAFT)
  periodStart    DateTime
  periodEnd      DateTime
  issueDate      DateTime
  dueDate        DateTime
  subtotal       Decimal              @db.Decimal(12, 2)
  discountTotal  Decimal              @default(0) @db.Decimal(12, 2)
  taxTotal       Decimal              @db.Decimal(12, 2)
  total          Decimal              @db.Decimal(12, 2)
  amountPaid     Decimal              @default(0) @db.Decimal(12, 2)
  sentAt         DateTime?
  createdAt      DateTime             @default(now())
  lines          InvoiceLine[]
  payments       Payment[]
  redemptions    DiscountRedemption[]

  // Nothing is billed twice: one invoice per subscription per period
  @@unique([subscriptionId, periodStart])
  @@index([status, dueDate])
  @@index([customerId])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  taxPct      Decimal @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal @default(0) @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2) // negative for discount lines
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  method    String
  amount    Decimal  @db.Decimal(12, 2)
  paidOn    DateTime
  note      String?

  @@index([invoiceId])
}

// Key/value store: "simulatedDate", counters
model AppSetting {
  key   String @id
  value String
}
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

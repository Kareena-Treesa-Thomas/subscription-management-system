# Local Postgres from docker-compose.yml
DATABASE_URL="postgresql://brightloop:brightloop@localhost:5432/brightloop?schema=public"
DIRECT_URL="postgresql://brightloop:brightloop@localhost:5432/brightloop?schema=public"

# On Vercel/Supabase: DATABASE_URL = pooled (port 6543, add ?pgbouncer=true), DIRECT_URL = direct (port 5432)

# Timezone used to decide "today" when no simulated date is set
APP_TZ="Asia/Kolkata"

# Stand-in for the real login until requireRole() from the auth module is wired in: ADMIN | STAFF | CUSTOMER
DEV_ROLE="ADMIN"

// Shared data model (see build plan section 7).
// Member 4 (payments / dashboard / data) owns: Payment, the indexes, and the finance queries.
// User, Plan, Subscription, Invoice, InvoiceLine are minimal stand-ins so this module runs on its own.
// When merging, keep the other members' versions of those models and make sure the columns
// listed in README.md ("What this module needs from the others") still exist.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  CHEQUE
}

model User {
  id               String         @id @default(uuid()) @db.Uuid
  name             String
  email            String         @unique
  passwordHash     String         @map("password_hash")
  role             Role           @default(CUSTOMER)
  company          String?
  createdAt        DateTime       @default(now()) @map("created_at")
  subscriptions    Subscription[]
  invoices         Invoice[]
  paymentsRecorded Payment[]

  @@index([role])
  @@map("users")
}

model Plan {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  price         Decimal        @db.Decimal(12, 2)
  billingPeriod BillingPeriod  @map("billing_period")
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id              String             @id @default(uuid()) @db.Uuid
  number          String             @unique
  customerId      String             @map("customer_id") @db.Uuid
  customer        User               @relation(fields: [customerId], references: [id])
  planId          String             @map("plan_id") @db.Uuid
  plan            Plan               @relation(fields: [planId], references: [id])
  status          SubscriptionStatus @default(DRAFT)
  startDate       DateTime           @map("start_date") @db.Date
  expiryDate      DateTime?          @map("expiry_date") @db.Date
  recurringAmount Decimal            @map("recurring_amount") @db.Decimal(12, 2)
  createdAt       DateTime           @default(now()) @map("created_at")
  invoices        Invoice[]

  @@index([status])
  @@index([customerId])
  @@map("subscriptions")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  number         String        @unique
  subscriptionId String        @map("subscription_id") @db.Uuid
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id])
  customerId     String        @map("customer_id") @db.Uuid
  customer       User          @relation(fields: [customerId], references: [id])
  status         InvoiceStatus @default(DRAFT)
  periodStart    DateTime      @map("period_start") @db.Date
  periodEnd      DateTime      @map("period_end") @db.Date
  issueDate      DateTime      @map("issue_date") @db.Date
  dueDate        DateTime      @map("due_date") @db.Date
  subtotal       Decimal       @db.Decimal(12, 2)
  discountTotal  Decimal       @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal       Decimal       @map("tax_total") @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  createdAt      DateTime      @default(now()) @map("created_at")
  lines          InvoiceLine[]
  payments       Payment[]

  // Idempotent billing: one invoice per subscription per period
  @@unique([subscriptionId, periodStart])
  // Dashboard + overdue queries
  @@index([status, dueDate])
  @@index([customerId])
  @@index([issueDate])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  taxAmount   Decimal @map("tax_amount") @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  invoiceId    String        @map("invoice_id") @db.Uuid
  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
  method       PaymentMethod
  amount       Decimal       @db.Decimal(12, 2)
  paidOn       DateTime      @map("paid_on") @db.Date
  note         String?
  recordedById String?       @map("recorded_by_id") @db.Uuid
  recordedBy   User?         @relation(fields: [recordedById], references: [id])
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([invoiceId])
  @@index([paidOn])
  @@map("payments")
}

// Key/value settings. "simulated_date" (YYYY-MM-DD) is the demo "simulate date" value.
// The billing module's simulate-date button should write this key; every page here reads it.
model AppSetting {
  key   String @id
  value String

  @@map("app_settings")
}
